# Copy this file to .env and paste your key(s). NEVER commit .env.
#
# One-key setup (recommended):
#   ZHIPU_API_KEY: https://open.bigmodel.cn -> API keys (runs EVERYTHING:
#   transcription AND summaries). Also set SUMMARY_MODEL below.
# Classic setup (your own DeepSeek account for summaries):
#   DEEPSEEK_API_KEY: https://platform.deepseek.com -> API keys
ZHIPU_API_KEY=

# Set this to run summaries through GLM with the same key as above
# (recommended: glm-5.3-flash). Leave unset to use DeepSeek instead.
# SUMMARY_MODEL=glm-5.3-flash

# Classic setup only: your DeepSeek key for summaries.
# DEEPSEEK_API_KEY=

# Optional: override the DeepSeek model (default deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash
