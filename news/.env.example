# Copy this file to .env and paste your DeepSeek key (the SAME key the
# transcriber uses — platform.deepseek.com). NEVER commit .env.
# Without it the briefing still works, but shows raw headlines instead of
# AI summaries.
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek model (default deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash
